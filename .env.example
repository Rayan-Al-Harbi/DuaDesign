# ─── Groq + Qwen 3.8 27B ───
# Get your key at: https://console.groq.com/keys
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# allam-2-7b is Arabic-specialised but too small for this task: measured on the
# same prompt it produced broken constructions, asked for a husband when the
# wish was for a wife, and drifted onto topics nobody asked about. The 27B
# reliably uses the retrieved authentic wordings verbatim instead.
# Avoid the gpt-oss reasoning models here: they spend the whole output budget
# reasoning and return nothing.
LLM_MODEL=qwen/qwen3.8-27b

# Optional. TTS reuses LLM_API_KEY when the LLM is Groq-hosted; uncomment only
# to point TTS at a different Groq key.
# GROQ_API_KEY=gsk_your_groq_key_here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
